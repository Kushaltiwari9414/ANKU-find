PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# ========================================================
# REAL-TIME OTP DELIVERY CONFIGURATION
# ========================================================

# Option 1: Twilio Verify v2 (Supports WhatsApp or SMS OTP)
# Provision API Keys at https://console.twilio.com/runtime/api-keys
# Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Or use TWILIO_AUTH_TOKEN instead of API Key/Secret:
# TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VAaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Set channel to "whatsapp" or "sms":
TWILIO_VERIFY_CHANNEL=whatsapp

# Option 2: Fast2SMS (Direct Indian SMS)
FAST2SMS_API_KEY=

# Option 3: 2Factor.in (Indian SMS)
TWOFACTOR_API_KEY=

# Option 4: Twilio Programmable SMS (Direct number)
TWILIO_PHONE_NUMBER=

# Option 5: Custom SMS Gateway Webhook
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_AUTH_HEADER=authorization
