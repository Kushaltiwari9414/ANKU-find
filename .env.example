PORT=3000
NODE_ENV=development
# Use a long random value in production. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Production OTP delivery. When either value is absent in development,
# the server logs the generated OTP and returns a clearly labelled devOtp.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_AUTH_HEADER=authorization
