PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# ========================================================
# REAL SMS DELIVERY OPTIONS (Choose ONE provider)
# ========================================================

# Option 1: Fast2SMS (Recommended for India - fastest & free signup credits)
# Sign up at https://www.fast2sms.com and copy your API Key from Dev API
FAST2SMS_API_KEY=

# Option 2: 2Factor.in (Specialized for Indian mobile OTP)
# Sign up at https://2factor.in and get your API Key
TWOFACTOR_API_KEY=

# Option 3: Twilio (Global SMS)
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 4: Custom Generic SMS Gateway Webhook
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_AUTH_HEADER=authorization
